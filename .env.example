# Database
# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./razryad.db
# PostgreSQL (production-ready)
# DATABASE_URL=postgresql://razryad:password@localhost:5432/razryad

# Security (CHANGE IN PRODUCTION!)
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-USE-openssl-rand-base64-32
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Email confirmation token TTL (seconds)
EMAIL_CONFIRM_TTL=86400

# Development mode (enables verbose errors, auto-reload)
DEV_MODE=true

# LLM features (item generation, calibration sandbox)
LLM_ENABLED=false
LLM_API_KEY=

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Grade change cooldown (days)
GRADE_CHANGE_COOLDOWN_JUNIOR=30
GRADE_CHANGE_COOLDOWN_MIDDLE_PLUS=90

# Assessment parameters
CAT_MIN_ITEMS=12
CAT_MAX_ITEMS=18
CAT_TIME_LIMIT=2700
CAT_SE_THRESHOLD=0.35

# Matching parameters
FRESHNESS_DECAY_DAYS=45

# Rate limits
INVITATION_DAILY_LIMIT=20
INVITATION_WEEKLY_LIMIT=100

# S3 / MinIO (optional, for resume storage)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=razryad

# Redis (optional, for caching and background jobs)
REDIS_URL=
